# Initialize the FastAPI application
app = FastAPI()

@app.get("/{org}/sum/{a}/{b}")
def get_sum(org: str, a: int, b: int):
    """
    Exposes the sum of two integers via a path parameter route.
    Example: google/sum/5/10 -> returns 15
    """
    result = a + b
    
    return {
        "organisation": org,
        "input_a": a,
        "input_b": b,
        "total_sum": result
    }
